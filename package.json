{
  "name": "sakuku",
  "version": "1.0.0",
  "description": "SakuKu - Personal Multi-Wallet Finance Tracker & WhatsApp Bot",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start",
    "bot": "tsx src/bot/worker.ts",
    "worker": "tsx src/bot/worker.ts",
    "start:worker": "tsx src/bot/worker.ts",
    "dev:all": "concurrently -n \"WEB,WORKER\" -c \"cyan,green\" \"next dev -p 3000\" \"tsx src/bot/worker.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test:parser": "tsx src/bot/parser.test.ts",
    "test:handler": "tsx --env-file=.env src/bot/handler.test.ts",
    "test:excel": "tsx src/lib/excel-parser.test.ts",
    "test:timezone": "tsx src/lib/timezone.test.ts",
    "test:totp": "tsx src/lib/totp.test.ts",
    "test": "npm run test:parser && npm run test:excel && npm run test:timezone && npm run test:totp",
    "auth:setup-totp": "tsx scripts/setup-totp.ts"
  },
  "keywords": [
    "sakuku",
    "finance",
    "multi-wallet",
    "whatsapp-bot",
    "baileys",
    "nextjs",
    "prisma"
  ],
  "author": "Rizal Kurniawan",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "next": "^14.2.18",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "pg": "^8.13.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.17.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}

# ==============================================================================
# SAKUKU - PERSONAL MULTI-WALLET FINANCE TRACKER & WHATSAPP BOT
# Cloud & Local Environment Configuration
# ==============================================================================

# 1. DATABASE CONNECTION URL (Supabase PostgreSQL / Neon / SQLite)
# Untuk Cloud Production (Supabase Transaction Pooler port 6543):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
# Untuk Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# 2. SISTEM KEAMANAN & AUTENTIKASI WEB DASHBOARD (GOOGLE AUTHENTICATOR TOTP)
# Nomor WhatsApp Pemilik (Whitelist Keamanan & Penerima Laporan Audit Keamanan Pasif)
MY_PHONE_NUMBER="628563006136"

# Kunci Rahasia Admin untuk melindungi halaman Web QR (/admin/qr) dan API (/api/bot/qr)
ADMIN_SECRET_KEY="ganti_dengan_kode_rahasia_acak_anda"

# Secret key untuk menandatangani JWT Smart Session Cookie (sakuku_session) - minimal 32 karakter
JWT_SECRET="ganti_dengan_jwt_secret_rahasia_panjang_minimal_32_karakter_acak"

# Kunci rahasia Base32 Google Authenticator TOTP (Metode Login Utama SakuKu)
# Hasilkan dengan menjalankan: npm run auth:setup-totp
TOTP_SECRET="JBSWY3DPEHPK3PXP"

# Secret key untuk otorisasi endpoint internal Next.js -> Worker HTTP Bridge (/internal/send-wa)
# Digunakan untuk pengiriman laporan audit keamanan pasif ke WhatsApp pemilik
INTERNAL_API_SECRET="ganti_dengan_internal_bridge_secret_rahasia_acak"

# Base URL worker SakuKu di Render / localhost (untuk pengiriman notifikasi keamanan pasif)
# Local: http://localhost:8080 | Production Render: https://sakuku-worker.onrender.com
WORKER_URL="http://localhost:8080"

# URL Web Dashboard Frontend (Vercel)
NEXT_PUBLIC_APP_URL="https://sakuku.vercel.app"

# 3. WORKER SERVER & PORT
# Port untuk worker HTTP health-check endpoint (default 8080 di Render/Docker)
PORT=8080
NODE_ENV="production"

# 4. PREFERENSI PENGGUNA DEFAULT
DEFAULT_USER_NAME="Rizal Kurniawan"

# 5. JADWAL NOTIFIKASI CRON (WIB / Asia/Jakarta)
TIMEZONE="Asia/Jakarta"
CRON_DAILY_REMINDER="0 20 * * *"
CRON_MONTHLY_REPORT="0 21 28-31 * *"
CRON_YEARLY_REPORT="0 21 31 12 *"

# 6. FEATURE FLAGS
NEXT_PUBLIC_ENABLE_EXCEL_IMPORT="false"
ENABLE_EXCEL_IMPORT="false"

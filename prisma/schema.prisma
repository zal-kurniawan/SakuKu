// SakuKu PostgreSQL / Supabase Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WalletType {
  BANK
  EWALLET
  CASH
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionSource {
  WHATSAPP
  WEB
}

model User {
  id               String            @id @default(cuid())
  name             String?
  phoneNumber      String            @unique
  language         String            @default("id")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  wallets          Wallet[]
  transactions     Transaction[]
  budgetLimits     BudgetLimit[]
  notificationLogs NotificationLog[]

  @@map("users")
}

model Wallet {
  id                      String            @id @default(cuid())
  userId                  String
  name                    String
  type                    WalletType        @default(BANK)
  balance                 Float             @default(0)
  colorCode               String            @default("#3B82F6")
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions            Transaction[]     @relation("SourceWallet")
  destinationTransactions Transaction[]     @relation("DestinationWallet")

  @@unique([userId, name])
  @@map("wallets")
}

model Transaction {
  id                  Int               @id @default(autoincrement())
  userId              String
  title               String
  amount              Float
  type                TransactionType
  category            String            @default("Lainnya")
  walletId            String
  destinationWalletId String?
  notes               String?
  source              TransactionSource @default(WEB)
  date                DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet              Wallet            @relation("SourceWallet", fields: [walletId], references: [id], onDelete: Cascade)
  destinationWallet   Wallet?           @relation("DestinationWallet", fields: [destinationWalletId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([walletId])
  @@map("transactions")
}

model BudgetLimit {
  id           String   @id @default(cuid())
  userId       String
  category     String
  monthlyLimit Float
  month        Int
  year         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month, year])
  @@map("budget_limits")
}

model NotificationLog {
  id         String   @id @default(cuid())
  userId     String?
  type       String
  targetDate String
  status     String   @default("SENT")
  payload    String?
  sentAt     DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, targetDate])
  @@map("notification_logs")
}

model WhatsAppSession {
  id        String   @id
  data      String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("whatsapp_sessions")
}

model AuthOtp {
  id          String    @id @default(cuid())
  codeHash    String    // SHA-256 hash dari 6 digit OTP
  expiresAt   DateTime  // Berlaku 3 menit
  attempts    Int       @default(0)
  lockedUntil DateTime? // Diisi jika salah >= 5x (kunci 15 menit)
  isUsed      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@map("auth_otps")
}

model AuthSecurityState {
  id                   String    @id @default("singleton")
  lastUsedTotpStep     BigInt?   // Anti-replay: mencegah kode TOTP 30 detik yang sama dipakai 2x
  totpAttempts         Int       @default(0)
  totpLockedUntil      DateTime? // Kunci 15 menit jika salah TOTP >= 5x
  pendingSecurityAlert String?   // Menyimpan pesan audit login darurat saat WA offline untuk dikirim begitu WA online
  updatedAt            DateTime  @updatedAt

  @@map("auth_security_states")
}
